{
  "name": "palc-pokeanalyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.electron-preload.json",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron dist-electron/main.js\"",
    "build:electron": "tsc -b && ELECTRON=true vite build",
    "electron:preview": "npm run build:electron && npm run electron:build && electron dist-electron/main.js",
    "download:uv": "node scripts/download-uv.mjs",
    "dist": "npm run build:electron && npm run electron:build && npm run download:uv && electron-builder",
    "dist:win": "npm run build:electron && npm run electron:build && npm run download:uv && electron-builder --win",
    "dist:mac": "npm run build:electron && npm run electron:build && npm run download:uv && electron-builder --mac",
    "dist:linux": "npm run build:electron && npm run electron:build && npm run download:uv && electron-builder --linux"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^8.0.5"
  }
}
